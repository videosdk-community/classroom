{
  /* The Vercel functions, typechecked as Node runs them.

     A separate project rather than an include on tsconfig.node.json, for one
     reason: that project sets allowImportingTsExtensions, which happily
     accepts `from './_lib/tokens.ts'` - the exact import that dies on Vercel
     with ERR_MODULE_NOT_FOUND. Omitting it here, with nodenext resolution,
     makes TypeScript DEMAND the .js extension instead. The ESM footgun
     becomes a compile error rather than a deploy-time surprise.

     strict is on, which is new for this repo. Code that holds the signing
     secret should not run with implicit any. */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
