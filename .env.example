# ---------------------------------------------------------------------------
# SERVER-ONLY. Never prefix any of these with VITE_.
# Anything VITE_-prefixed is inlined into the browser bundle at build time.
# A post-build check fails the build if one of these names reaches dist/.
# ---------------------------------------------------------------------------

# VideoSDK. Needed to create rooms and to sign meeting tokens (HS256).
VIDEOSDK_API_KEY=
VIDEOSDK_SECRET=

# Supabase service role. Used only by the API functions to verify a session
# and to insert a room row - browsers have no insert policy on public.rooms.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Safe in the browser. These are meant to ship.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
