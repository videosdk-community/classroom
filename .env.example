# ---------------------------------------------------------------------------
# SERVER-ONLY. Never prefix any of these with VITE_.
# Anything VITE_-prefixed is inlined into the browser bundle at build time.
# A post-build check fails the build if one of these names reaches dist/.
# ---------------------------------------------------------------------------

# VideoSDK. Needed to create rooms and to sign meeting tokens (HS256).
VIDEOSDK_API_KEY=
VIDEOSDK_SECRET=

# Supabase service role. Used only by the API functions to verify a session
# and to insert a room row - browsers have no insert policy on public.rooms.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Safe in the browser. These are meant to ship.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# TEMPORARY - step 4 only. Deleted at step 6 together with src/sdk/dev/ and
# scripts/mint-dev-token.mjs.
#
# A hand-minted meeting token, so the SDK seam can join a real room before
# api/session.ts exists. Do not set these by hand: run
#
#     node scripts/mint-dev-token.mjs
#
# which creates a room and writes both to .env.local.
#
# Dev builds only. The reader is gated on import.meta.env.DEV, which Vite
# replaces with `false` in a production build, so the whole path including
# these reads is dead code and gets dropped. Verified by grepping dist/.
# ---------------------------------------------------------------------------

VITE_DEV_MEETING_TOKEN=
VITE_DEV_MEETING_ID=
